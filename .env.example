# AGRONEON Backend Environment Configuration

# -----------------------------------------------------
# Application Settings
# -----------------------------------------------------
PROJECT_NAME="AGRONEON AI Application"
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# -----------------------------------------------------
# Database Configuration
# -----------------------------------------------------
# Replace with your local or docker PostgreSQL credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agroneon"
# If using docker-compose, use: "postgresql://postgres:postgres@db:5432/agroneon"

# -----------------------------------------------------
# Security Settings
# -----------------------------------------------------
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="supersecret_demo_key_please_change_in_production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# -----------------------------------------------------
# API Integrations (Optional)
# -----------------------------------------------------
WEATHER_API_KEY=""  # OpenWeatherMap API Key
GROQ_API_KEY=""     # For LLM-based voice assistant (currently uses context engine)

# -----------------------------------------------------
# Machine Learning
# -----------------------------------------------------
MODEL_PATH="../ai/models/crop_rf_model.pkl"
SCALER_PATH="../ai/models/scaler.pkl"
ENCODER_PATH="../ai/models/label_encoder.pkl"
